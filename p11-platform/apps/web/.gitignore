# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build
/runtime-assets/*.zip
/runtime-assets/*.manifest.*
# First-party packages are release inputs. Keep the licensed ACF archive local.
!/runtime-assets/oneclick-siteforge.zip
!/runtime-assets/oneclick-siteforge-runtime.zip
!/runtime-assets/oneclick-siteforge-runtime.zip.manifest.json
!/runtime-assets/oneclick-siteforge-runtime.zip.manifest.sha256

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Google Cloud credentials
google-credentials.json
*-credentials.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local
/.swc
