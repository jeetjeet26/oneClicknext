{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run theme:validate && next build",
    "start": "next start -p $PORT",
    "lint": "eslint",
    "lint:foundation": "node ./scripts/foundation-lint.mjs",
    "schema:types:stamp": "node ./scripts/stamp-supabase-types-version.mjs",
    "theme:acf:generate": "node ./scripts/generate-siteforge-acf.mjs",
    "theme:acf:check": "node ./scripts/generate-siteforge-acf.mjs --check",
    "theme:validate": "node ./scripts/validate-siteforge-build-inputs.mjs",
    "theme:build": "node ./scripts/build-siteforge-theme.mjs --build",
    "theme:check": "node ./scripts/build-siteforge-theme.mjs --check",
    "runtime:build": "node ./scripts/build-siteforge-runtime-plugin.mjs",
    "runtime:build:v3": "node ./scripts/build-siteforge-runtime-plugin.mjs --v3",
    "runtime:check:v3": "node ./scripts/build-siteforge-runtime-plugin.mjs --check --v3",
    "runtime:publish": "tsx ./scripts/publish-siteforge-runtime-packages.ts",
    "runtime:provision": "tsx ./scripts/provision-siteforge-runtime-v2.ts",
    "theme:verify": "node ./scripts/build-siteforge-theme.mjs --verify",
    "siteforge:artifacts:generate": "npm run theme:acf:generate",
    "siteforge:artifacts:build": "npm run theme:acf:check && npm run theme:build && npm run runtime:build:v3",
    "siteforge:artifacts:drift-check": "npm run theme:acf:check && npm run theme:check && npm run runtime:check:v3",
    "siteforge:deployment-assets:verify": "npm run theme:verify",
    "siteforge:verticals:qualify": "tsx ./scripts/qualify-siteforge-verticals.ts",
    "siteforge:eval:premium": "tsx ./evals/forge/run-premium-creative.ts",
    "check:schema-types-sync": "node ./scripts/check-schema-types-sync.mjs",
    "check:schema-truth": "npm run check:schema-types-sync && node ./scripts/check-schema-truth.mjs && node ./scripts/check-rls-policy-guards.mjs",
    "check:runtime-config-hardening": "node ./scripts/check-runtime-config-hardening.mjs",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "test:watch": "vitest",
    "typecheck:foundation": "node ./scripts/foundation-typecheck.mjs",
    "check:foundation": "npm run theme:validate && npm run check:schema-truth && node ./scripts/check-foundation-trust-boundaries.mjs && npm run check:runtime-config-hardening && npm test && npm run lint:foundation && npm run typecheck:foundation",
    "heroku-postbuild": "npm run build",
    "worker:forgestudio": "node ./scripts/forgestudio-worker.mjs",
    "backfill:existing-brands": "node --env-file-if-exists=.env.local --env-file-if-exists=../../.env.local --import tsx ./scripts/backfill-existing-brand-contracts.ts",
    "backfill:siteforge-artifact-hashes": "node --env-file-if-exists=.env.local --env-file-if-exists=../../.env.local --import tsx ./scripts/backfill-siteforge-artifact-hashes.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.70",
    "@ai-sdk/gateway": "4.0.102",
    "@ai-sdk/openai": "4.0.83",
    "@anthropic-ai/sdk": "0.130.0",
    "@browserbasehq/sdk": "2.21.0",
    "@google/generative-ai": "0.24.1",
    "@noble/hashes": "2.4.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@vercel/sandbox": "3.5.1",
    "ai": "7.0.124",
    "axe-core": "4.13.0",
    "cheerio": "1.2.0",
    "date-fns": "4.4.0",
    "fflate": "0.8.3",
    "google-auth-library": "11.1.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "openai": "7.25.0",
    "pixelmatch": "7.2.0",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "resend": "6.31.0",
    "sonner": "2.0.8",
    "ssh2": "1.17.0",
    "unpdf": "1.8.1",
    "uuid": "14.0.2",
    "workflow": "5.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "18.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vite": "8.3.1"
  },
  "overrides": {
    "@workflow/core": {
      "nanoid": "5.1.16"
    },
    "js-yaml": "4.3.2",
    "@humanfs/node": "0.16.8",
    "@workflow/world-local": {
      "undici": "7.30.0"
    },
    "@workflow/world-vercel": {
      "undici": "7.30.0"
    },
    "dompurify": "3.4.16"
  },
  "packageManager": "npm@11.12.1"
}
